# AI Employee — Environment Configuration (Gold Tier)
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# Mode: set to "false" for live operation
DRY_RUN=true

# Vault path (defaults to ./AI_Employee_Vault)
VAULT_PATH=./AI_Employee_Vault

# ── Gmail API (required for live Gmail watcher) ──
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_CREDENTIALS=path/to/credentials.json

# ── LinkedIn API (required for live LinkedIn posting) ──
LINKEDIN_ACCESS_TOKEN=your_access_token

# ── Odoo ERP (required for live accounting integration) ──
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your_database
ODOO_USERNAME=admin
ODOO_API_KEY=your_odoo_api_key

# ── Facebook Graph API (required for live Facebook posting) ──
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_TOKEN=your_page_access_token

# ── Instagram Graph API (required for live Instagram posting) ──
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# ── Twitter/X API v2 (required for live tweeting) ──
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret

# ── Error Recovery Settings ──
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ── Ralph Wiggum Loop Settings ──
RALPH_MAX_ITERATIONS=50
RALPH_ENABLED=true
