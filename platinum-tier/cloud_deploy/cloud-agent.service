[Unit]
Description=AI Employee Cloud Agent (Platinum Tier)
Documentation=https://github.com/AhmedHKhan18/hackathon-zero
After=network-online.target
Wants=network-online.target
PartOf=ai-employee.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/platinum-tier

# Load .env secrets (never committed to git)
EnvironmentFile=/home/ubuntu/platinum-tier/.env

# Python venv path
Environment="PATH=/home/ubuntu/platinum-tier/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="AGENT_ID=cloud-agent"
Environment="VAULT_PATH=/home/ubuntu/platinum-tier/AI_Employee_Vault"

ExecStart=/home/ubuntu/platinum-tier/venv/bin/python cloud_agent.py \
    --vault-path /home/ubuntu/platinum-tier/AI_Employee_Vault \
    --interval 60

# Restart on failure with backoff
Restart=always
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloud-agent

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/platinum-tier

[Install]
WantedBy=multi-user.target
